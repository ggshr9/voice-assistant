#!/bin/bash
# 会议录制一键命令
# 用法：
#   rec              录麦克风（线下会议 / 自己说话）
#   rec online       录"会议录制"聚合设备（线上会议：对方+自己声音）
#   rec online 转写   录完自动调 meeting 转写
# 录制中按 Ctrl+C 停止保存；持续静音超过阈值也会自动停(默认 5 分钟)。
#
# 为什么要自动停:会议结束后忘了停录,尾部静音会被 ASR 幻觉成一长串「嗯」——
# 实测某次 1h48m 的会,结尾被填了 330 个「。嗯」,占转写全文 8.5%,还白烧转写时间。
# 用 ffmpeg 自带的 silencedetect(而不是另起一路 VAD,那样要抢同一个音频设备)。
#   REC_SILENCE_SEC=0    关闭自动停
#   REC_SILENCE_SEC=120  改成 2 分钟
#   REC_SILENCE_DB=-40   改灵敏度(越负越严格,默认 -35dB)

export PATH="/opt/homebrew/bin:$HOME/.local/bin:$PATH"
FFMPEG="${FFMPEG:-ffmpeg}"   # 可注入，便于测试用桩顶替（PATH 顶不掉上面这行）

MODE="$1"
AUTO="$2"
DIR="$HOME/会议录音"
mkdir -p "$DIR"
TS=$(date +%Y%m%d_%H%M)

if [ "$MODE" = "online" ]; then
  DEV="会议录制"          # 你在音频MIDI设置里建的聚合设备名
  OUT="$DIR/线上会议_$TS.m4a"
else
  DEV="MacBook Pro Microphone"
  OUT="$DIR/会议_$TS.m4a"
fi

# 检查设备是否存在
if ! "$FFMPEG" -f avfoundation -list_devices true -i "" 2>&1 | grep -q "\] $DEV"; then
  echo "⚠️ 找不到音频设备：「$DEV」"
  echo "当前可用设备："
  "$FFMPEG" -f avfoundation -list_devices true -i "" 2>&1 | sed -n '/audio devices/,/^$/p' | grep -oE '\[[0-9]+\].*'
  [ "$MODE" = "online" ] && echo "→ 线上录制需先在「音频 MIDI 设置」建好名为「会议录制」的聚合设备（见安装说明）。"
  exit 1
fi

SILENCE_SEC="${REC_SILENCE_SEC:-300}"
SILENCE_DB="${REC_SILENCE_DB:--35}"

# 实时反馈：电平表 + 抽样转写。默认开 —— 它要防的是「开完两小时才发现没录上」,
# 而那种时候你根本不会记得加参数。--quiet 只留电平表(不加载模型)。
LIVE_ARGS=""
for a in "$@"; do [ "$a" = "--quiet" ] && LIVE_ARGS="--no-asr"; done
# realpath 解软链 —— rec 是从 ~/.local/bin 软链调用的,不解就找不到同目录的兄弟脚本
REC_DIR="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")" && pwd)"
LIVE="$REC_DIR/_live_asr.py"
# 用 uv run 拉齐依赖:mlx-qwen3-asr 那个 venv 里没有 webrtcvad,
# 直接用它的 python 会静默降级成"只有电平表"(踩过)。uv 有缓存,启动开销可忽略。
LIVE_RUN=(uv run --quiet --with webrtcvad --with "setuptools<81" --with numpy \
          --with mlx-qwen3-asr python)
command -v uv >/dev/null || LIVE_RUN=(python3)

echo "🔴 开始录制（设备：$DEV）→ $OUT"
if [ "$SILENCE_SEC" = "0" ]; then
  echo "   说话/开会，结束按 Ctrl+C 停止...（静音自动停：已关闭）"
  "$FFMPEG" -f avfoundation -i ":$DEV" -ac 1 -ar 16000 -c:a aac "$OUT" 2>/dev/null
else
  echo "   说话/开会，结束按 Ctrl+C 停止...（持续静音 ${SILENCE_SEC}s 也会自动停）"
  LOG="$(mktemp -t rec-silence)"
  # silencedetect 只做检测、原样透传音频；d= 即「连续静音多久才算一次」
  # 滤镜链里必须先 aformat 成单声道:「会议录制」聚合设备给的是 2.1,实测第 3 路
  # (LFE)常年 RMS -39dB,而 silencedetect 要求【所有声道】都低于阈值才算静音 ——
  # 于是自动停从来没触发过(实测设 8 秒、跑满 7 分钟不停)。命令行上的 `-ac 1` 是
  # 【输出】选项,在滤镜之后才生效,救不了这个。
  # 用 FIFO 而不是管道:`a | b &` 时 $! / jobs -p 拿到的是【管道最后一个进程】,
  # 也就是转写器 —— 静音自停会杀错对象,ffmpeg 继续录,整个挂住(踩过)。
  FIFO="$(mktemp -u -t rec-pcm)"; mkfifo "$FIFO"
  "${LIVE_RUN[@]}" "$LIVE" $LIVE_ARGS < "$FIFO" &
  LIVEPID=$!
  # 一路存 m4a、一路把 PCM 送进 FIFO。silencedetect 只做检测、原样透传。
  "$FFMPEG" -f avfoundation -i ":$DEV" -ac 1 -ar 16000 \
         -af "aformat=channel_layouts=mono,silencedetect=noise=${SILENCE_DB}dB:d=${SILENCE_SEC}" \
         -c:a aac "$OUT" \
         -f s16le -ac 1 -ar 16000 pipe:1 > "$FIFO" 2> "$LOG" &
  FFPID=$!
  # Ctrl+C 只转发给 ffmpeg,【不能】同时杀转写器 —— 转写器一死就没人读 FIFO,
  # ffmpeg 立刻阻塞在写管道上,处理不了信号,moov 永远写不出来,整个 m4a 报废。
  # 实测踩过两次(会议_20260825_2312.m4a:786KB 音频在、moov 没有、ffmpeg -c copy
  # 也救不回来)。正确顺序:先让 ffmpeg 收尾退出,再收拾转写器。
  trap 'kill -INT "$FFPID" 2>/dev/null' INT TERM
  while kill -0 "$FFPID" 2>/dev/null; do
    if grep -q "silence_start" "$LOG" 2>/dev/null; then
      echo ""
      echo "🤫 检测到持续静音 ${SILENCE_SEC}s，自动停止录制。"
      kill -INT "$FFPID" 2>/dev/null
      break
    fi
    sleep 2
  done
  wait "$FFPID" 2>/dev/null
  kill "$LIVEPID" 2>/dev/null; wait "$LIVEPID" 2>/dev/null
  trap - INT TERM
  rm -f "$LOG" "$FIFO"
  echo ""
fi

echo ""
# 落地校验:ffmpeg 被强杀 / 磁盘满 / 设备掉线,都会留下读不出的 m4a。
# 从前这里无条件打绿勾,用户要到转写时才发现录了个寂寞 —— 那时已经不可挽回。
DUR="$("$FFMPEG" -v error -i "$OUT" -f null - 2>&1 >/dev/null | head -1)"
if [ -n "$DUR" ] || [ ! -s "$OUT" ]; then
  echo "❌ 录音文件读不出来：$OUT"
  echo "   ${DUR:-文件为空}"
  echo "   （音频数据可能还在文件里但索引没写上，别删，先备份）"
  exit 1
fi
echo "✅ 录音已保存：$OUT"
if [ "$AUTO" = "转写" ] || [ "$AUTO" = "transcribe" ]; then
  echo "▶ 自动转写中..."
  meeting "$OUT"
fi
