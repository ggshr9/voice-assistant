#!/bin/bash
# 从公司内网 GPU 机器(ssh gpu-server → gpu-box, 2× RTX 4090)
# 把 ~/voice-svc/web/ 同步回仓库。**那台机器是 web/ 的真源**,仓库这份是镜像。
#
#   sync-web          # 拉回(默认)
#   sync-web --check  # 只看差异,不改动
#
# 排除项是安全边界,不要删:
#   secrets.env  含 CAPTION_LLM_KEY / CAPTION_ACCESS_PW
#   *.pem        TLS 私钥与证书
# 拉回后务必复查内网地址:服务器版把 10.0.0.1 写成了 env 默认值,
# 仓库里必须保持「默认空 + 缺失即报错」,否则一转公开就是内网拓扑泄漏。
set -e
REMOTE="${SYNC_WEB_REMOTE:-gpu-server}"
SRC="$REMOTE:~/voice-svc/web/"
DST="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)/web/"

RSYNC_ARGS=(-az --delete
  --exclude='secrets.env' --exclude='*.pem'
  --exclude='__pycache__' --exclude='.bak')

if [ "$1" = "--check" ]; then
  echo "▶ 与 $REMOTE 的差异（不改动本地）："
  rsync "${RSYNC_ARGS[@]}" --dry-run -i -e ssh "$SRC" "$DST"
  exit 0
fi

echo "▶ 从 $REMOTE 拉回 web/ …"
rsync "${RSYNC_ARGS[@]}" -e ssh "$SRC" "$DST"

# 服务器版把内网网关写成了 env 默认值。仓库必须保持「默认空 + 缺失即报错」,
# 所以每次同步都就地洗一遍 —— 否则每拉一次就把内网拓扑带回来一次。
echo "▶ 洗掉内网默认地址 …"
python3 - "$DST" <<'PYEOF'
import pathlib, re, sys
root = pathlib.Path(sys.argv[1])
pat = re.compile(r'os\.environ\.get\((\s*"CAPTION_LLM_URL"\s*),\s*"http://[\d.]+:\d+[^"]*"\)')
for f in root.rglob("*.py"):
    s = f.read_text(encoding="utf-8")
    new = pat.sub(r'os.environ.get(\1, "")   # 必须显式配置(线上由 secrets.env 注入)', s)
    if new != s:
        f.write_text(new, encoding="utf-8")
        print(f"   洗净 {f.relative_to(root.parent)}")
PYEOF

echo "▶ 复查凭据与内网地址 …"
BAD=0
grep -rn "10\.84\.\|195\.133\." "$DST" 2>/dev/null && BAD=1
grep -rlE "BEGIN .*PRIVATE KEY|sk-[A-Za-z0-9]{16}" "$DST" 2>/dev/null && BAD=1
ls "$DST"/secrets.env "$DST"/*.pem 2>/dev/null && BAD=1
if [ "$BAD" = 1 ]; then
  echo "❌ 上面这些必须先处理再 commit（内网地址改成默认空 / 凭据删掉）"
  exit 1
fi
echo "✅ 同步完成，未发现凭据或内网地址。"
