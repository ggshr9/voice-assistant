#!/bin/bash
# 从公司内网 GPU 机器(ssh gpu-server → gpu-box, 2× RTX 4090)
# 把 ~/voice-svc/web/ 同步回仓库。**那台机器是 web/ 的真源**,仓库这份是镜像。
#
#   sync-web          # 拉回(默认)
#   sync-web --check  # 只看差异,不改动
#
# 同步方向有两个,别搞混:
#   拉(pull):web/ 与 voice-svc 的服务代码 —— 真源在服务器,在那台机器上迭代
#   推(push):prompts.py / _voiceprint.py —— 真源在本仓库(代码)
#            ~/.config/voiceprints.json —— 声纹注册表(数据,不在仓库里)
#            纪要 prompt 属于产品决策,该跟仓库走版本;两边曾各存一份,实测漂移到只剩 66% 相似
#
# ⚠️ 声纹是生物特征。推送等于把它留在公司那台机器上,所以要显式开关:
#      SYNC_VOICEPRINTS=1 sync-web    才会推;默认不推。
#      撤回:删本机 ~/.config/voiceprints.json 与服务器 ~/voice-svc/voiceprints.json
#
# 排除项是安全边界,不要删:
#   secrets.env  含 CAPTION_LLM_KEY / CAPTION_ACCESS_PW
#   *.pem        TLS 私钥与证书
# 拉回后务必复查内网地址:服务器版把内网网关写成了 env 默认值,
# 仓库里必须保持「默认空 + 缺失即报错」,否则一转公开就是内网拓扑泄漏。
set -e
# 服务器地址不写死在仓库里(那是你的网络拓扑,不该公开)。
# 优先级:环境变量 > ~/.config/sync-web.env > 占位默认值
[ -f "$HOME/.config/sync-web.env" ] && . "$HOME/.config/sync-web.env"
REMOTE="${SYNC_WEB_REMOTE:-gpu-server}"
SRC="$REMOTE:~/voice-svc/web/"
REPO="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
DST="$REPO/web/"
SVC_DST="$REPO/server/"     # voice-svc 根上的服务代码(STT 服务 / 启动脚本 / systemd unit)

RSYNC_ARGS=(-az --delete
  --exclude='secrets.env' --exclude='*.pem'
  --exclude='__pycache__' --exclude='.bak' --exclude='*.bak-*')

if [ "$1" = "--check" ]; then
  echo "▶ 与 $REMOTE 的差异（不改动本地）："
  rsync "${RSYNC_ARGS[@]}" --dry-run -i -e ssh "$SRC" "$DST"
  echo "（prompts.py 为推送方向，不在此比对）"
  exit 0
fi

echo "▶ 推共享代码到 ${REMOTE}（prompt 与声纹逻辑以仓库为准）…"
scp -q "$REPO/prompts.py" "$REMOTE:~/voice-svc/prompts.py"
scp -q "$REPO/bin/_voiceprint.py" "$REMOTE:~/voice-svc/_voiceprint.py"
scp -q "$REPO/noise_filter.py" "$REMOTE:~/voice-svc/noise_filter.py"   # 幻觉过滤,唯一一份
scp -q "$REPO/llm_chain.py" "$REMOTE:~/voice-svc/llm_chain.py"         # 候选链语义,唯一一份

VP="$HOME/.config/voiceprints.json"
if [ "${SYNC_VOICEPRINTS:-0}" = "1" ] && [ -f "$VP" ]; then
  echo "▶ 推声纹注册表（生物特征，将留存在公司机器上）…"
  scp -q "$VP" "$REMOTE:~/voice-svc/voiceprints.json"
  ssh "$REMOTE" 'chmod 600 ~/voice-svc/voiceprints.json'
elif [ -f "$VP" ]; then
  echo "  （声纹注册表未推送。要推：SYNC_VOICEPRINTS=1 sync-web）"
fi

echo "▶ 从 $REMOTE 拉回 web/ …"
rsync "${RSYNC_ARGS[@]}" -e ssh "$SRC" "$DST"

echo "▶ 拉回 voice-svc 根上的服务代码 …"
mkdir -p "$SVC_DST"
rsync -az -e ssh \
  --exclude='__pycache__' --exclude='*.bak-*' \
  "$REMOTE:~/voice-svc/stt_server_cuda.py" \
  "$REMOTE:~/voice-svc/run_stt.sh" \
  "$SVC_DST"
rsync -az --delete -e ssh --exclude='__pycache__' \
  "$REMOTE:~/voice-svc/systemd/" "$SVC_DST/systemd/"

# 服务器版把内网网关写成了 env 默认值。仓库必须保持「默认空 + 缺失即报错」,
# 所以每次同步都就地洗一遍 —— 否则每拉一次就把内网拓扑带回来一次。
echo "▶ 洗掉内网默认地址 …"
python3 - "$DST" "$SVC_DST" <<'PYEOF'
import pathlib, re, sys
roots = [pathlib.Path(a) for a in sys.argv[1:] if pathlib.Path(a).exists()]
pat = re.compile(r'os\.environ\.get\((\s*"CAPTION_LLM_URL"\s*),\s*"http://[\d.]+:\d+[^"]*"\)')
# 绑定地址同理:服务器上写的是真实内网/Tailscale 地址,仓库里不该有
host = re.compile(r'os\.environ\.get\((\s*"STT_HOST"\s*),\s*"(?!127\.0\.0\.1|0\.0\.0\.0)[^"]*"\)')
# 证书路径里写死的域名同理:那是部署细节,仓库里该是占位
dom = re.compile(r'le/live/[A-Za-z0-9.-]+/')
for root in roots:
  for f in root.rglob("*.py"):
    s = f.read_text(encoding="utf-8")
    new = pat.sub(r'os.environ.get(\1, "")   # 必须显式配置(线上由 secrets.env 注入)', s)
    new = host.sub(r'os.environ.get(\1, "127.0.0.1")   # 部署时用 STT_HOST 指定', new)
    new = dom.sub('le/live/caption.example.com/', new)
    if new != s:
        f.write_text(new, encoding="utf-8")
        print(f"   洗净 {f.relative_to(root.parent)}")
PYEOF

echo "▶ 复查凭据与内网地址 …"
BAD=0
grep -rn "10\.84\.\|195\.133\." "$DST" "$SVC_DST" 2>/dev/null && BAD=1
grep -rlE "BEGIN .*PRIVATE KEY|sk-[A-Za-z0-9]{16}" "$DST" 2>/dev/null && BAD=1
ls "$DST"/secrets.env "$DST"/*.pem 2>/dev/null && BAD=1
if [ "$BAD" = 1 ]; then
  echo "❌ 上面这些必须先处理再 commit（内网地址改成默认空 / 凭据删掉）"
  exit 1
fi
echo "✅ 同步完成，未发现凭据或内网地址。"
