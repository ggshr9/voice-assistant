#!/bin/bash
# 会议转写一键命令（本地 Qwen3-ASR-1.7B + 可选 pyannote 声纹 + 自动纪要）
# 用法：
#   meeting 录音.m4a              # 中文转写（+ 若 community-1 已就绪则分说话人）+ 自动纪要
#   meeting 录音.m4a 3            # 指定 3 个说话人
#   meeting 录音.m4a -            # 只转写，不分说话人
#   meeting 录音.m4a - nominutes  # 转写但不生成纪要
#   meeting 录音.m4a 2 --me 说话人1   # 告诉纪要哪个说话人是「我」→ 待办我的/他人才准
#
# 引擎：mlx-qwen3-asr（Qwen3-ASR-1.7B，2026 中文 SOTA，超过 whisper-large-v3）
#   - 纯本地离线、词级时间戳；模型缓存后 RTF ~60x
# 声纹分人：需 pyannote/speaker-diarization-community-1 已缓存 + HF_TOKEN
#   - 没缓存会自动降级为纯转写（首次启用：网页同意条款后让我帮你下）

set -e
export PATH="/opt/homebrew/bin:$HOME/.local/bin:$PATH"
export HF_ENDPOINT=https://huggingface.co   # 直连官方（门控/Xet 不走镜像）

FILE="$1"
SPEAKERS="$2"
# MLX 量化权重,不是 HF 全精度那份。实测同一段 265s 音频(不分人):
#   Qwen/Qwen3-ASR-1.7B(全精度 4.4G)  48s = 5.5x 实时
#   mlx-community/…-8bit (2.3G)        8s = 33.1x 实时   ← 快 6 倍
# 转写文本相似度 98.91%,质量没有代价。MEETING_MODEL=… 可覆盖。
ASR_MODEL="${MEETING_MODEL:-mlx-community/Qwen3-ASR-1.7B-8bit}"

# 抽出 --me <说话人>（传给 minutes，让待办区分我的/他人）
ME=""
for ((i=1; i<=$#; i++)); do
  if [ "${!i}" = "--me" ]; then j=$((i+1)); ME="${!j}"; fi
done

if [ -z "$FILE" ]; then
  echo "用法: meeting <音频/视频文件> [说话人数 | - 表示不分人] [nominutes]"
  exit 1
fi

# 绝对路径 + 输出目录
FILE="$(cd "$(dirname "$FILE")" && pwd)/$(basename "$FILE")"
WORKDIR="$(dirname "$FILE")"
OUT="$WORKDIR/转写_$(basename "${FILE%.*}")"
mkdir -p "$OUT"

# 清掉上一轮残留的 _annotated.txt：只有本轮 ≥2 人时才会重新生成；
# 否则旧文件会被 minutes 错误优先，导致单人/重转写还读到上次的说话人标注
rm -f "$OUT"/*_annotated.txt 2>/dev/null || true

ARGS=(--model "$ASR_MODEL" --language Chinese --output-dir "$OUT" --output-format all)

# 声纹分人走 GPU:上游 mlx-qwen3-asr 从不把 pyannote pipeline .to(device),一直跑 CPU。
# 实测 265s 音频分人 CPU 117.5s → MPS 4.4s(快 26.7 倍),逐帧归属一致率 100%。
# 用仓库里的 shim 包一层上游的私有加载函数,上游代码一行不改。见 bin/_asr_mps.py
REPO_DIR="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
SHIM="$REPO_DIR/bin/_asr_mps.py"
ASR_PY="$(head -1 "$(command -v mlx-qwen3-asr)" 2>/dev/null | sed 's|^#!||')"
if [ -f "$SHIM" ] && [ -x "$ASR_PY" ]; then
  ASR=("$ASR_PY" "$SHIM")
else
  echo "  ℹ️  找不到 GPU 分人 shim，用上游默认(分人会慢很多)"
  ASR=(mlx-qwen3-asr)
fi

# 是否具备声纹分人条件：用户没明确关闭 + 有 HF_TOKEN + community-1 已缓存
have_diar() { ls "$HOME"/.cache/huggingface/hub/*speaker-diarization-community*/snapshots/*/config.yaml >/dev/null 2>&1; }

DIARIZE=0
if [ "$SPEAKERS" = "-" ]; then
  echo "▶ 转写（不分说话人，$ASR_MODEL）"
  export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1        # 纯转写可离线
elif [ -z "$HF_TOKEN" ]; then
  echo "▶ 转写（未设 HF_TOKEN，不分说话人）"
  export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
elif ! have_diar; then
  echo "▶ 转写（本地无 community-1 分人模型，暂不分说话人）"
  echo "  ℹ️  想要声纹分人？先在 https://hf.co/pyannote/speaker-diarization-community-1 同意条款，再让我帮你下。"
  export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
else
  DIARIZE=1
  ARGS+=(--diarize)
  [ -n "$SPEAKERS" ] && ARGS+=(--num-speakers "$SPEAKERS")
  echo "▶ 转写 + 声纹分人（$ASR_MODEL + community-1）"
  # 分人走 pyannote，需联网做 HEAD 校验（直连官方）；缓存命中后很快
fi

# 声纹向量落盘,供 who label / 自动识别用(shim 在分人那一次调用里截获)
export MEETING_EMBED_OUT="$OUT/.embeddings.npz"

echo "  文件: $FILE"
# 跑转写；若开了分人却失败，自动降级纯转写离线重试
if ! "${ASR[@]}" "$FILE" "${ARGS[@]}"; then
  if [ "$DIARIZE" = 1 ]; then
    echo "⚠️ 声纹分人失败，降级为纯转写重试…"
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
      "${ASR[@]}" "$FILE" --model "$ASR_MODEL" --language Chinese \
        --output-dir "$OUT" --output-format all
  else
    echo "❌ 转写失败。"; exit 1
  fi
fi

echo ""
echo "✅ 转写完成，结果在: $OUT/"
ls "$OUT" 2>/dev/null

# —— 分人后：从 json 的逐字 speaker 标签，按说话人轮次合成带标注的 _annotated.txt ——
# （Qwen3-ASR 只把 speaker 写进 json，txt/srt 是纯文本；minutes 读不到说话人，这里补上）
if [ "$DIARIZE" = 1 ]; then
  JSON="$(ls "$OUT"/*.json 2>/dev/null | head -1)"
  if [ -n "$JSON" ]; then
    # 先用声纹认人：认出来的用真名，认不出的仍是 说话人A/B/C
    NAMES="$(python3 "$REPO_DIR/bin/_identify.py" "$OUT" || true)"   # stderr 放行,让识别结果可见
    if [ -n "$NAMES" ]; then
      python3 "$REPO_DIR/bin/_annotate.py" "$JSON" "$OUT" --names "$NAMES"
    else
      python3 "$REPO_DIR/bin/_annotate.py" "$JSON" "$OUT"
    fi
  fi
fi

# 分了人但没说"我是谁"：提示如何让待办准确区分我的/他人（重跑 minutes 很快）
if [ -z "$ME" ] && ls "$OUT"/*_annotated.txt >/dev/null 2>&1; then
  echo ""
  echo "💡 已分出多个说话人。想让纪要待办准确区分「我的/他人」？"
  echo "   先看下面 annotated 里哪个是你，再跑(几秒)：minutes \"$OUT\" --me 说话人A"
fi

# —— 闭环：转写完自动生成结构化纪要（本地 LLM）——
if [ "$2" != "nominutes" ] && [ "$3" != "nominutes" ] && command -v minutes >/dev/null 2>&1; then
  echo ""
  echo "▶ 自动生成会议纪要（本地 Qwen3.6）…"
  minutes "$OUT" ${ME:+--me "$ME"}
fi
