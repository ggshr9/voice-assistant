# 必填:网页访问口令
CAPTION_ACCESS_PW=换成你的口令

# 纪要/翻译/问答用的 LLM(任何 OpenAI 兼容端点;逗号分隔=候选链,前面挂了自动退后面)
CAPTION_LLM_URL=https://api.example.com/v1/chat/completions
CAPTION_LLM_KEY=
CAPTION_LLM_MODEL=gpt-4o-mini

# 可选:录音保留天数(0=永久);CPU 口味的 whisper 模型(tiny/small/large-v3-turbo)
CAPTION_RETENTION_DAYS=0
CPU_ASR_MODEL=small
