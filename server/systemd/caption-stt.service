# 占位符 __USER__ / __HOME__ 必须先替换成真实值再安装。
# systemd 系统级 unit 里 %h 会解析成 /root、%i 只在模板单元有效，
# 所以这里不用 systemd 的 specifier，用显式占位更不容易出错。
# 渲染：见 docs/DEPLOY.md「systemd」一节的 sed 命令。
[Unit]
Description=Realtime Caption STT (faster-whisper on CUDA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HOME__/voice-svc
EnvironmentFile=-__HOME__/voice-svc/hf.env
ExecStart=__HOME__/voice-svc/run_stt.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
